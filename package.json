{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"dev": "HOST=127.0.0.1 vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vp test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit": "pnpm audit --audit-level=high",
		"preflight:server": "node --import ./scripts/ts-resolve.mjs scripts/preflight-server.ts",
		"notices": "node scripts/third-party-notices.ts",
		"restore": "node --import ./scripts/ts-resolve.mjs scripts/restore-backup.ts",
		"accounts": "node scripts/accounts.ts",
		"quickstart:sample": "node --import ./scripts/ts-resolve.mjs scripts/quickstart-sample.ts",
		"start": "node server.js",
		"serve": "vp build && HOST=127.0.0.1 PORT=4321 node server.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.2",
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^1.28.0",
		"@tanstack/svelte-table": "^9.1.2",
		"better-auth": "^1.7.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.13",
		"drizzle-orm": "^0.45.2",
		"marked": "^18.0.7",
		"mode-watcher": "^1.1.0",
		"mysql2": "^3.23.2",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	}
}
