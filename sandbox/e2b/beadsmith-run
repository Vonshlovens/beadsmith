#!/usr/bin/env bash
# One agent run inside a Beadsmith E2B sandbox (docs/sand-e2b.md).
#
#   beadsmith-run <run-id>
#
# Beadsmith's e2b provider (src/lib/server/dispatch/e2b-provider.ts) writes
# ~/.beadsmith/runs/<run-id>/prompt and starts this script in the background.
# The provider reads these files back; keep the names in step with it:
#
#   pid          the agent's process (and process group) id
#   events.jsonl Claude Code's stream-json event log
#   stderr.log   the agent's stderr (its end goes to Beadsmith's server log on
#                failure, never to the browser)
#   started_ms   finished_ms   exit   (exit code; written last)
#   cancelled    created by the provider before it stops the run
#   setup.log    this script's own output
#
# The run also starts the sandbox's hc core (the terminal server agents run
# in, ADR-0021) once setup is done.
#
# Environment from the sandbox: BEADSMITH_REPO_URL/_REF, BEADSMITH_TS_TAGS,
# BEADSMITH_DOLT_TAILNET_HOST/_PORT, BEADS_DOLT_* (the project's own scoped
# Dolt account) and placeholder ANTHROPIC_API_KEY / GH_TOKEN values, which
# E2B's egress replaces with the real keys. Per run: BEADSMITH_TS_AUTHKEY (a
# single-use ephemeral Tailscale key) and BEADSMITH_CONTINUE (1 = follow-up).
set -uo pipefail

run_id="${1:?usage: beadsmith-run <run-id>}"
[[ "$run_id" =~ ^r[1-9][0-9]{0,5}$ ]] || { echo "bad run id" >&2; exit 2; }

base="$HOME/.beadsmith"
dir="$base/runs/$run_id"
work="$base/work"
ts_dir="$base/tailscale"
ts_sock="$ts_dir/tailscaled.sock"
mkdir -p "$dir" "$ts_dir"
exec >>"$dir/setup.log" 2>&1

now_ms() { date +%s%3N; }
finish() {
	now_ms >"$dir/finished_ms"
	echo "$1" >"$dir/exit"
	exit "$1"
}
now_ms >"$dir/started_ms"
touch "$dir/events.jsonl"
# Until the agent starts, cancel stops this script itself.
echo "$$" >"$dir/pid"

ts() { tailscale --socket="$ts_sock" "$@"; }

# --- Tailnet: a fresh userspace tailscaled each run ---------------------------
# Userspace networking needs no TUN device or root. A paused-then-resumed
# sandbox may have lost its ephemeral node (and E2B rotates its proxy CA on
# resume), so restart cleanly and join with this run's single-use key.
pkill -f "tailscaled .*--socket=$ts_sock" 2>/dev/null
pkill -f "socat TCP-LISTEN:${BEADS_DOLT_SERVER_PORT:-3306}" 2>/dev/null
sleep 0.5
# E2B gives the sandbox only a link-local address (169.254.0.x). tailscaled
# does not count link-local as a usable network, decides the machine is
# offline and pauses its control client, so `tailscale up` waits forever.
# One private address on the unused dummy0 is enough to unpause it; nothing
# routes to it. Already present after a resume: ignore the error.
sudo -n ip link set dummy0 up 2>/dev/null
sudo -n ip addr add 10.254.254.1/32 dev dummy0 2>/dev/null
# Debian installs the daemon in /usr/sbin, which is not on the user's PATH.
/usr/sbin/tailscaled --tun=userspace-networking --state=mem: --socket="$ts_sock" \
	--statedir="$ts_dir" >"$ts_dir/tailscaled.log" 2>&1 &
for _ in $(seq 1 50); do [ -S "$ts_sock" ] && break; sleep 0.2; done

key_file="$ts_dir/authkey"
(umask 077; printf '%s' "${BEADSMITH_TS_AUTHKEY:-}" >"$key_file")
unset BEADSMITH_TS_AUTHKEY
ts up --auth-key="file:$key_file" --hostname="bdx-${E2B_SANDBOX_ID:-sandbox}" \
	--advertise-tags="${BEADSMITH_TS_TAGS:-tag:beads-sandbox}" --accept-dns=false \
	--timeout=60s
up=$?
rm -f "$key_file"
if [ "$up" -ne 0 ]; then
	echo "tailscale up failed"
	finish 10
fi

# Dolt over the tailnet, as plain TCP on loopback for bd.
dolt_host="${BEADSMITH_DOLT_TAILNET_HOST:-beads}"
dolt_port="${BEADSMITH_DOLT_TAILNET_PORT:-3306}"
socat "TCP-LISTEN:${BEADS_DOLT_SERVER_PORT:-3306},bind=127.0.0.1,reuseaddr,fork" \
	"EXEC:tailscale --socket=$ts_sock nc $dolt_host $dolt_port" &
# Wait for Dolt's greeting, not just the local listener: Beads' tailnet
# policy reaches host beads a few seconds after this node joins, and until
# then its packets are dropped and a connection hangs instead of failing.
dolt_up=0
for _ in $(seq 1 30); do
	if timeout 3 bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$1" && head -c 1 <&3 >/dev/null' _ \
		"${BEADS_DOLT_SERVER_PORT:-3306}" 2>/dev/null; then
		dolt_up=1
		break
	fi
	sleep 2
done
if [ "$dolt_up" -ne 1 ]; then
	echo "Dolt did not answer over the tailnet ($dolt_host:$dolt_port)"
	finish 13
fi

# --- Checkout (first run only) -----------------------------------------------
if [ ! -d "$work" ]; then
	if [ -n "${BEADSMITH_REPO_URL:-}" ]; then
		# Auth is added by E2B's egress for github.com; no credential here.
		if ! git clone --branch "${BEADSMITH_REPO_REF:-main}" "$BEADSMITH_REPO_URL" "$work"; then
			echo "clone failed"
			finish 11
		fi
	else
		mkdir -p "$work"
	fi
fi
cd "$work" || finish 12

# The prompt names .agents/skills/<name>/SKILL.md. Those skills belong to
# Beadsmith, which writes them to ~/.beadsmith/skills before each run; install
# any the checkout lacks (another repository, or none) and keep them out of git.
for skill in "$base"/skills/*/SKILL.md; do
	[ -f "$skill" ] || continue
	name="$(basename "$(dirname "$skill")")"
	target=".agents/skills/$name"
	if [ ! -f "$target/SKILL.md" ] || [ -f "$target/.beadsmith" ]; then
		mkdir -p "$target"
		cp -f "$skill" "$target/SKILL.md"
		touch "$target/.beadsmith"
		if git rev-parse --git-dir >/dev/null 2>&1; then
			grep -qxF "/$target/" .git/info/exclude 2>/dev/null || echo "/$target/" >>.git/info/exclude
		fi
	fi
done

# bd needs a .beads/ workspace even when BEADS_DOLT_* says where the server
# is, and .beads/ is usually not committed. Write a server-mode one unless
# the checkout brought its own; the environment overrides its values anyway.
if [ ! -f .beads/metadata.json ]; then
	mkdir -p .beads
	chmod 700 .beads
	printf '{"database":"dolt","backend":"dolt","dolt_mode":"server","dolt_server_host":"127.0.0.1","dolt_server_port":%s,"dolt_database":"%s"}\n' \
		"${BEADS_DOLT_SERVER_PORT:-3306}" "${BEADS_DOLT_SERVER_DATABASE:-}" >.beads/metadata.json
	# Never push or sync from a sandbox: Dolt is the shared server.
	printf 'no-push: true\ndolt:\n  local-only: true\n' >.beads/config.yaml
	if git rev-parse --git-dir >/dev/null 2>&1; then
		grep -qxF '.beads/' .git/info/exclude 2>/dev/null || echo '.beads/' >>.git/info/exclude
	fi
fi

# --- The terminal server (ADR-0021) -------------------------------------------
# Agents run in hc terminals, which take their environment from the hc core,
# not from whoever asks for them. Start the core here, after the tailnet, the
# Dolt forward and the checkout are ready, so it inherits this sandbox's
# BEADS_DOLT_* account, placeholders and CA settings (the single-use
# Tailscale key is already unset). Already running (a follow-up, or a resumed
# sandbox): `hc server start` leaves it as it is. Its own session, so a
# cancel that stops this run's process group leaves the core and the other
# runs' terminals alone. The core listens only on its Unix socket in a 0700
# directory; Beadsmith reaches it through beadsmith-hc over the E2B process
# channel, never a port (ADR-0021 rule 1).
if ! setsid -w hc server start --json; then
	echo "hc server start failed"
	finish 14
fi

# --- The agent ----------------------------------------------------------------
args=(-p --output-format stream-json --verbose --dangerously-skip-permissions)
[ "${BEADSMITH_CONTINUE:-0}" = "1" ] && args+=(--continue)

[ -f "$dir/cancelled" ] && finish 130
# A session of its own, so cancel can stop the agent and everything it started.
setsid claude "${args[@]}" <"$dir/prompt" >"$dir/events.jsonl" 2>"$dir/stderr.log" &
agent=$!
echo "$agent" >"$dir/pid"
wait "$agent"
finish $?
