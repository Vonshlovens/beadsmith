# Beadsmith Compose settings. Copy to .env next to compose.yaml.
# Non-secret values only: passwords and API keys go in ./secrets/ as files.
# Beadsmith itself never reads .env; Compose passes these into the container.

# --- Image and container -------------------------------------------------
# Pin a tag in production; :latest can lag or jump.
BEADSMITH_IMAGE=ghcr.io/vonshlovens/beadsmith:latest
# Owner of ./data and ./secrets on the host: `id -u` and `id -g`.
BEADSMITH_UID=1000
BEADSMITH_GID=1000
BEADSMITH_PORT=4321

# --- Accounts ----------------------------------------------------------------
# Always on: every page needs a sign-in. First admin: open /auth and paste the
# token from data/setup-token. The session-signing secret is generated in
# data/auth-secret; set this only to supply your own from a secret manager.
#BETTER_AUTH_SECRET_FILE=/run/secrets/better-auth-secret

# --- Network mode ----------------------------------------------------------
# Default (bridge): published on 127.0.0.1:BEADSMITH_PORT.
# Server behind a same-machine reverse proxy or tunnel: uncomment both.
# The process then binds host loopback only.
#BEADSMITH_NETWORK=host
#BEADSMITH_BIND=127.0.0.1

# --- Dolt ------------------------------------------------------------------
# A SELECT-only SQL user is enough (README: "Use your own Beads projects").
# Password: ./secrets/dolt-password
# Docker Desktop reaches a Dolt on the host as host.docker.internal; in host
# network mode use 127.0.0.1.
BEADS_DOLT_SERVER_HOST=
BEADS_DOLT_SERVER_PORT=3306
BEADS_DOLT_SERVER_USER=beadsmith

# --- Secrets stored in the app (optional) -----------------------------------
# Master key for backup credentials entered in Console -> Backups. Without it,
# Beadsmith generates data/secret.key. Create: openssl rand -base64 32 > secrets/master-key
#BDX_SECRET_KEY_FILE=/run/secrets/master-key

# --- Public hostname (optional) ---------------------------------------------
# The Host people use, and its https origin when a proxy terminates TLS.
#BDX_ALLOWED_HOSTS=beads.example.com
#BDX_PUBLIC_ORIGIN=https://beads.example.com

# --- Cloudflare Access in front (optional) ----------------------------------
# Issuer and audience together. People still sign in to their account; the
# listed service-token Client IDs may read /api (docs/agent-access.md).
#BDX_CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
#BDX_CF_ACCESS_AUDIENCE=
#BDX_CF_ACCESS_ALLOWED_SERVICE_TOKEN_IDS=

# --- Agent dispatch (optional) -----------------------------------------------
# A list of webhook, e2b, or none; the first is the default. Unset: none
# (File/Tackle hidden). The First Mate "Runs on" picker chooses among them.
#BDX_DISPATCH_PROVIDER=webhook,e2b
#BDX_DISPATCH_WEBHOOK_LABEL=forge
# Webhook runner (docs/file-tackle-dispatch.md#webhook-runner-contract-version-1):
#BDX_DISPATCH_WEBHOOK_URL=https://runner.example.com/beadsmith
#BDX_DISPATCH_WEBHOOK_SECRET_FILE=/run/secrets/dispatch-webhook-secret

# --- First Mate runner (optional) --------------------------------------------
# One long-lived orchestrator agent per chat (docs/first-mate.md). Admin-only.
# Unset: First Mate keeps chats and answers with a placeholder.
#BDX_MATE_RUNNER_URL=https://mate-runner.example.com
#BDX_MATE_RUNNER_SECRET_FILE=/run/secrets/mate-runner-secret
#BDX_MATE_RUNNER_LABEL=forge
# Chat runners, default first: remote (the URL above) and/or e2b (Sand).
#BDX_MATE_RUNNERS=remote,e2b

# --- Sand: E2B sandboxes (optional; docs/sand-e2b.md) ------------------------
# One E2B microVM per mission or chat; no KVM host needed. Keys stay outside
# the sandbox: E2B's egress adds them to requests.
#BDX_E2B_LABEL=Sand
#BDX_E2B_API_KEY_FILE=/run/secrets/e2b-api-key
#BDX_E2B_TEMPLATE=beadsmith-agent
# One model credential: an Anthropic API key, or a Claude subscription token.
#BDX_E2B_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic-api-key
#BDX_E2B_CLAUDE_OAUTH_TOKEN_FILE=/run/secrets/claude-oauth-token
# Dispatch only: each mission's sandbox joins the tailnet to reach Dolt.
#BDX_E2B_DOLT_ACCOUNTS_FILE=/run/secrets/e2b-dolt-accounts.json
#BDX_E2B_TAILSCALE_OAUTH_CLIENT_ID=
#BDX_E2B_TAILSCALE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/tailscale-oauth-secret
#BDX_E2B_TAILSCALE_TAGS=tag:beads-sandbox
#BDX_E2B_DOLT_TAILNET_HOST=beads
# Repository checkouts (Tackle): a GitHub App, one-repository tokens per run.
#BDX_E2B_GITHUB_APP_ID=
#BDX_E2B_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
